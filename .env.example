DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/prpath"
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""
APP_URL="http://localhost:3000"
# Scheduled jobs (POST /api/cron/monitor and /api/cron/notify) send: Authorization: Bearer $CRON_SECRET (24+ characters)
CRON_SECRET=""
# Comma-separated emails allowed to use the review queue at /review
REVIEWER_EMAILS=""
# Set to "on" to offer AI explanations and the assistant (needs Anthropic credentials)
PRPATH_AI=""
# Public base URL used in emails
# APP_URL is above
# Only when running more than one server instance (not on Vercel): base64 AES key shared by all instances
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
# Set once an email provider is wired into lib/mail.ts
MAIL_PROVIDER=""
