generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String?
  consentAt      DateTime
  consentVersion String
  emailReminders Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions     Session[]
  resetTokens  PasswordResetToken[]
  profile      Profile?
  assessments  Assessment[]
  scenarios    Scenario[]
  deadlines    Deadline[]
  auditLogs    AuditLog[]
  documents     Document[]
  refusals      RefusalAnalysis[]
  notifications Notification[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

/// Questionnaire answers, encrypted with AES-256-GCM before storage.
model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ciphertext     String
  completedSteps String[]
  schemaVersion  Int      @default(1)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

/// A frozen run of the rule engine. Never updated after creation.
model Assessment {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String   @default("crs")
  ruleSetVersion String
  inputSnapshot  String
  result         Json
  total          Int
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model Scenario {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  ruleSetVersion String
  input          String
  total          Int
  createdAt      DateTime @default(now())

  @@index([userId])
}

model Deadline {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  title       String
  dueDate     DateTime
  source      String    @default("user")
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, dueDate])
}

/// Registry of rule versions so any assessment can be traced to its rules.
model RuleSet {
  id            String    @id @default(cuid())
  key           String
  version       String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  sourceUrl     String
  verifiedAt    DateTime
  notes         String?

  @@unique([key, version])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// An uploaded document. The file is encrypted with its own random key, which
/// is itself encrypted with the app key; deleting the row destroys the key.
model Document {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType    String
  mime       String
  size       Int
  wrappedKey String
  iv         String
  tag        String
  content    Bytes
  /// Encrypted JSON: original filename, extracted text and fields, dates the user confirmed.
  meta       String
  consentAt  DateTime
  createdAt  DateTime @default(now())

  refusals RefusalAnalysis[]

  @@index([userId, createdAt])
}

/// A refusal letter analysis. Input text and result are encrypted.
model RefusalAnalysis {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  cipher     String
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

/// An official page we watch for changes.
model SourceWatch {
  id            String           @id @default(cuid())
  url           String           @unique
  label         String
  jurisdiction  String
  lastHash      String?
  lastText      String?
  lastFetchedAt DateTime?
  lastStatus    String?
  lastChangedAt DateTime?
  createdAt     DateTime         @default(now())
  reviews       ReviewItem[]
}

/// A detected change waiting for a person to review. Nothing is published automatically.
model ReviewItem {
  id         String      @id @default(cuid())
  watchId    String
  watch      SourceWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)
  detectedAt DateTime    @default(now())
  added      String[]
  removed    String[]
  status     String      @default("pending") // pending | dismissed | published
  reviewedBy String?
  reviewedAt DateTime?
  note       String?
  update     UpdateItem?

  @@index([status, detectedAt])
}

/// A reviewed, published update. Announced and effective dates are separate:
/// an announcement is never shown as policy in effect.
model UpdateItem {
  id           String      @id @default(cuid())
  reviewId     String?     @unique
  review       ReviewItem? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  kind         String
  title        String
  summary      String
  jurisdiction String
  sourceUrl    String
  announcedOn  DateTime?
  effectiveOn  DateTime?
  status       String // announced | in_effect | ended
  publishedBy  String
  publishedAt  DateTime    @default(now())

  @@index([publishedAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Stable key so a job never sends the same reminder twice.
  key       String
  kind      String
  title     String
  body      String
  href      String?
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  readAt    DateTime?
  emailedAt DateTime?

  @@unique([userId, key])
  @@index([userId, readAt])
}
